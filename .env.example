# Connexion à la base MySQL
DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/DATABASE

# Clé secrète de signature des tokens de session CLI (JWT)
SECRET_KEY=change-me

# Journalisation des erreurs avec Sentry
# DSN du projet Python cree sur sentry.io (laisser vide pour desactiver Sentry)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development